generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  issues        issues[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model issues {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Issues_userId_fkey")

  @@index([userId], map: "Issues_userId_fkey")
}
